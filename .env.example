# ==============================================================================
# Root .env.example - Nuit Fragrances WhatsApp Customer Support Bot Configuration
#
# Copy this file to '.env' at the root of the project if you want a reference of 
# all environment variables needed by the backend and frontend services.
# Note: The startup script 'spin_up.sh' will automatically configure local 
# database credentials, but you will need to fill in provider credentials manually.
# ==============================================================================

# ── 1. LLM Provider Credentials ───────────────────────────────────────────────
PROVIDER_API_KEY=your-api-key-here
PROVIDER_BASE_URL=https://models.github.ai/inference
PROVIDER_MODEL_NAME=openai/gpt-4.1-mini


# ── 3. Meta WhatsApp Cloud API Settings ───────────────────────────────────────
# Get these from: https://developers.facebook.com/apps/ -> WhatsApp -> API Setup
WHATSAPP_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_API_VERSION=v18.0
WEBHOOK_VERIFY_TOKEN=your-custom-webhook-verify-token-string

# ── 4. HubSpot CRM Settings ───────────────────────────────────────────────────
# Get this from: HubSpot Settings -> Integrations -> Private Apps
HUBSPOT_ACCESS_TOKEN=your-hubspot-private-app-token

# ── 5. LangSmith Observability & Tracing (Optional) ───────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=nuit-bot-v2
